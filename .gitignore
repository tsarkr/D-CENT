# Ignore editor settings
.vscode/

# Settings and secrets (.streamlit/secrets.toml)
.streamlit/

# TEI and raw data
tei/
data/

# Python env
.venv*/
env/

# Python cache
__pycache__/

# Secrets and config
.env
*.secret

# Raw/large files
*.csv
*.tei.xml

# OS files
.DS_Store

# Generated outputs (the pipeline writes them to data/output/, which is ignored with data/)

# PHP dependencies
vendor/

# Vector store
vector_store/

Latex/
# Evaluation: annotation workbooks, blinding key, validation workbook
evaluation/annotation/**/*.xlsx
evaluation/annotation/rating_key/
evaluation/dataset/validation/
~$*.xlsx
# Not research data: simulated annotations (dry runs), the author's trial, set-aside workbooks
evaluation/annotation/sim/
evaluation/annotation/trial/
evaluation/annotation/old*/
evaluation/annotation/expert/*.json

# Local caches (including renamed copies)
.pg_meta_cache*.json
